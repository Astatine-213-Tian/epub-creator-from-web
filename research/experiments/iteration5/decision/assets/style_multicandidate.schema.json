{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "judgments"],
  "properties": {
    "packet_id": {"type": "string"},
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "style_adherence", "naturalness", "rationale"],
        "properties": {
          "candidate_id": {"type": "string"},
          "style_adherence": {"type": "integer", "minimum": 1, "maximum": 5},
          "naturalness": {"type": "integer", "minimum": 1, "maximum": 5},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
